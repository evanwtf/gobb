# Copy this file to .env and set POSTGRES_PASSWORD. Do not commit .env.

# The image tag to pull: a version without the "v", such as 0.1.0 (the release tag
# is v0.1.0). "latest" tracks the newest release.
GOBB_VERSION=latest

# The database password. Compose refuses to start while this is empty.
POSTGRES_PASSWORD=

# The URL path prefix, when the forum lives under a path such as /forum/.
GOBB_BASE_PATH=/

# The proxies whose X-Forwarded-* headers gobb trusts, as comma-separated CIDRs.
# The default is the gateway of the pinned compose subnet.
GOBB_TRUSTED_PROXIES=10.231.0.1/32

# Mark the cookies Secure, so that a browser sends them only over HTTPS. Keep this
# "true" behind HTTPS. Set "false" only for a local run over plain http://127.0.0.1.
GOBB_COOKIE_SECURE=true

# The host port on 127.0.0.1 that maps to the container.
GOBB_PORT=8080

# The memory cap of the gobb container, with no swap on top. gobb sets its Go
# memory limit to 70% of it. Raise it for a board whose stored password hashes
# need more than 64 MiB each (README, "Memory").
GOBB_MEM_LIMIT=256m

# The board's public address, such as https://board.example.org/forum/: the canonical
# links and the sitemap use it, and so do the links in email. Its path is GOBB_BASE_PATH.
# Empty means no canonical links, and a sitemap that takes the host of each request.
GOBB_PUBLIC_URL=

# Email. Leave GOBB_SMTP_HOST empty to keep email off. With a host, GOBB_MAIL_FROM and
# GOBB_PUBLIC_URL (above) are required (README, "Email"). The password goes here and
# nowhere else. Keep .env out of git.
GOBB_SMTP_HOST=
GOBB_SMTP_PORT=
GOBB_SMTP_TLS=
GOBB_SMTP_USER=
GOBB_SMTP_PASSWORD=
GOBB_MAIL_FROM=
# The most reset emails the whole board sends in an hour and in a day: 1 to 100,000,
# and the hourly limit not more than the daily one. Empty means 10 and 20.
GOBB_MAIL_PER_HOUR=
GOBB_MAIL_PER_DAY=

# Load limits (README, "Load limits"). Empty means the default in brackets.
# The most database connections, 1 to 100 [4].
GOBB_DB_MAX_CONNS=
# The longest wait of a request for database connections, in total, 10ms to 5s [1s].
# A longer wait gets 503.
GOBB_DB_POOL_WAIT=
# The most searches of the whole board in any second, 1 to 1000 [5].
GOBB_SEARCH_PER_SECOND=
# The most searches at one time, 1 to GOBB_DB_MAX_CONNS - 1 [2].
GOBB_SEARCH_MAX_RUNNING=
# The memory of the guest page cache in MiB, 0 (off) to 1024 [16]. The server uses at
# most a quarter of its Go memory limit (44 MiB at GOBB_MEM_LIMIT=256m).
GOBB_PAGE_CACHE_MIB=
# Render the guest pages into the cache at start: true or false [true].
GOBB_PAGE_CACHE_WARM=
# The time between two writes of the view counts and visit times, 1s to 10m [30s].
GOBB_WRITE_FLUSH_INTERVAL=
# The longest wait of a sign-in for room in the memory gate of the password checks,
# counted from the start of the request, 100ms to 10s [1s]. A longer wait gets 503.
# Despite the name, avatar uploads also wait at most this long for the same gate.
GOBB_SIGNIN_GATE_WAIT=
# The most requests under way at one time, 1 to 100000 [256]. A request past it gets
# 503 at once. Outside it: GET /healthz, GET/HEAD of /favicon.ico and the known
# static files, cached guest pages, and the password POSTs (their own limit below).
GOBB_MAX_IN_FLIGHT=
# The most password POSTs under way at one time (sign-in, password and email
# change, admin confirm, reset link), on slots of their own outside
# GOBB_MAX_IN_FLIGHT, 1 to GOBB_MAX_IN_FLIGHT [32]. Taken once the body is read.
GOBB_MAX_SIGNIN_IN_FLIGHT=

# Sign-in limits (README, "Sign-in limits"). Empty means the default in brackets.
# Failures of an address or a name that leave no wait, 0 to 100 [2].
GOBB_SIGNIN_FREE_FAILURES=
# The waits after the later failures, in order, 1s to 24h each [15s,15s,60s,60s,60s].
GOBB_SIGNIN_WAITS=
# The wait after every failure past that list, 1s to 24h [900s].
GOBB_SIGNIN_LAST_WAIT=
# The time with no failure that clears a count, 1m to 720h, at least the longest wait [24h].
GOBB_SIGNIN_RESET_AFTER=
# Days that gobb keeps a member's address after its last use (sign-in or visit), 1 to 3650 [365].
GOBB_ADDRESS_KEEP_DAYS=
# The most counts in each table of the schedule (addresses, names), 1000 to 1000000 [50000].
GOBB_SIGNIN_TABLE_KEYS=
# Defensive Mode: on above this many failed sign-ins of the board, 1 to 10000 [100],
GOBB_DEFENSIVE_FAILURES=
# in this window, 1s to 1h [60s];
GOBB_DEFENSIVE_WINDOW=
# off after this long at or below that rate, 1s to 24h [10m].
GOBB_DEFENSIVE_QUIET=
# While it is on, the least time between two tries of an untrusted address, 0s to 1h [5s].
GOBB_DEFENSIVE_GAP=

# Metrics (README, "Metrics"). Off by default. With Compose, turn them on with
#   COMPOSE_FILE=compose.yaml:compose.metrics.yaml
# which sets GOBB_METRICS_LISTEN inside the container and publishes the port on the
# host's 127.0.0.1 only, at GOBB_METRICS_PORT (9187 when empty). The endpoint has no
# auth: never publish it on a public address. Outside Compose, set
# GOBB_METRICS_LISTEN=127.0.0.1:9187 in the environment of `gobb serve`.
GOBB_METRICS_PORT=

# Outside Compose, `gobb serve` reads these from the environment. Compose sets the
# first two itself; see "Run the server" in the README.
#   GOBB_DSN=postgres://USER@127.0.0.1:5432/gobb?sslmode=disable   (required)
#   GOBB_LISTEN=127.0.0.1:8080
#   GOBB_DATA_DIR=/var/lib/gobb
#   GOBB_BASE_PATH, GOBB_TRUSTED_PROXIES and GOBB_COOKIE_SECURE are set above.
