# Copy this file to .env and set POSTGRES_PASSWORD. Do not commit .env.

# The image tag to pull: a version without the "v", such as 0.1.0 (the release tag
# is v0.1.0). "latest" tracks the newest release.
GOBB_VERSION=latest

# The database password. Compose refuses to start while this is empty.
POSTGRES_PASSWORD=

# The URL path prefix, when the forum lives under a path such as /forum/.
GOBB_BASE_PATH=/

# The proxies whose X-Forwarded-* headers gobb trusts, as comma-separated CIDRs.
# The default is the gateway of the pinned compose subnet.
GOBB_TRUSTED_PROXIES=10.231.0.1/32

# Mark the cookies Secure, so that a browser sends them only over HTTPS. Keep this
# "true" behind HTTPS. Set "false" only for a local run over plain http://127.0.0.1.
GOBB_COOKIE_SECURE=true

# The host port on 127.0.0.1 that maps to the container.
GOBB_PORT=8080

# The memory cap of the gobb container, with no swap on top. gobb sets its Go
# memory limit to 70% of it. Raise it for a board whose stored password hashes
# need more than 64 MiB each (README, "Memory").
GOBB_MEM_LIMIT=256m

# Email. Leave GOBB_SMTP_HOST empty to keep email off. With a host, GOBB_MAIL_FROM and
# GOBB_PUBLIC_URL are required (README, "Email"). The password goes here and nowhere
# else. Keep .env out of git.
GOBB_SMTP_HOST=
GOBB_SMTP_PORT=
GOBB_SMTP_TLS=
GOBB_SMTP_USER=
GOBB_SMTP_PASSWORD=
GOBB_MAIL_FROM=
GOBB_PUBLIC_URL=

# Outside Compose, `gobb serve` reads these from the environment. Compose sets the
# first two itself; see "Run the server" in the README.
#   GOBB_DSN=postgres://USER@127.0.0.1:5432/gobb?sslmode=disable   (required)
#   GOBB_LISTEN=127.0.0.1:8080
#   GOBB_DATA_DIR=/var/lib/gobb
#   GOBB_BASE_PATH, GOBB_TRUSTED_PROXIES and GOBB_COOKIE_SECURE are set above.
